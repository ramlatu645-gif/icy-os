<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Associated Domains for verified iOS Universal Links -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:icy.example.org</string>
    </array>
    <!-- Keychain Access Groups for hardware-backed password verifier storage -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)org.iclauncher.app</string>
    </array>
</dict>
</plist>
